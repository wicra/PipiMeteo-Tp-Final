  ],
  "variable": [
    {
      "id": "apiKey",
      "key": "apiKey",
      "value": "VOTRE_CLE_API_OPENWEATHER",
      "type": "default",
      "description": "Cle API OpenWeather pour l'authentification. A remplacer par votre cle personnelle."
    },
    {
      "id": "baseUrl",
      "key": "baseUrl",
      "value": "https://api.openweathermap.org/data/2.5",
      "type": "default",
      "description": "URL de base de l'API OpenWeather."
    },
    {
      "id": "city",
      "key": "city",
      "value": "Paris",
      "type": "default",
      "description": "Nom de la ville a rechercher. Exemples: Paris, Lyon, Marseille, London, New York"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "id": "pre-request-script",
        "type": "text/javascript",
        "exec": [
          "// Vérification que la clé API est configurée",
          "if (!pm.environment.get('apiKey') || pm.environment.get('apiKey') === 'VOTRE_CLE_API_OPENWEATHER') {",
          "  pm.environment.set('apiKey', pm.collectionVariables.get('apiKey'));",
          "}",
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "id": "test-script",
        "type": "text/javascript",
        "exec": [
          "// Test de base pour toutes les requetes",
          "pm.test('La requete a ete envoyee avec succes', function() {",
          "  pm.response.to.have.status.oneOf([200, 404, 401, 429]);",
          "});",
          "",
          "// Test pour les reponses succes (200)",
          "pm.test('La reponse contient les donnees attendues', function() {",
          "  if (pm.response.code === 200) {",
          "    pm.expect(pm.response.json()).to.have.property('name');",
          "    pm.expect(pm.response.json()).to.have.property('sys');",
          "    pm.expect(pm.response.json()).to.have.property('main');",
          "    pm.expect(pm.response.json()).to.have.property('weather');",
          "    pm.expect(pm.response.json().weather).to.be.an('array').and.to.have.lengthOf.at.least(1);",
          "  }",
          "});",
          "",
          "// Test pour les erreurs 404",
          "pm.test('Erreur 404 - Ville introuvable', function() {",
          "  if (pm.response.code === 404) {",
          "    pm.expect(pm.response.json()).to.have.property('cod', '404');",
          "    pm.expect(pm.response.json()).to.have.property('message');",
          "  }",
          "});",
          "",
          "// Test du temps de reponse",
          "pm.test('Temps de reponse inferieur a 2 secondes', function() {",
          "  pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ]
}
