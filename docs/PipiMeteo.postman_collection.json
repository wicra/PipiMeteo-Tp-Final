                  "key": "lang",
                  "value": "fr",
                  "description": "Langue des descriptions (francais)"
                },
                {
                  "key": "cnt",
                  "value": "5",
                  "description": "Nombre de previsions (5 jours)"
                }
              ]
            },
            "description": "Endpoint pour recuperer les previsions meteo sur 5 jours pour une ville."
          },
