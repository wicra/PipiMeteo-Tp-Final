                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/weather?q=Paris&appid={{apiKey}}&lang=fr",
                  "host": ["{{baseUrl}}"],
                  "path": ["weather"],
                  "query": [
