{
  "info": {
    "_postman_id": "pipimeteo-collection",
    "name": "PipiMeteo - OpenWeather API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection Postman pour tester les endpoints OpenWeather utilises par l'application PipiMeteo. Cette collection permet de valider les appels API avant integration dans Angular."
  },
  "item": [
    {
      "name": "Meteo Actuelle",
      "description": "Recupere les donnees meteo actuelles pour une ville specifique.",
      "item": [
        {
          "name": "GET Weather by City",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/weather?q={{city}}&appid={{apiKey}}&lang=fr",
              "host": ["{{baseUrl}}"],
              "path": ["weather"],
              "query": [
                {
                  "key": "q",
                  "value": "{{city}}",
                  "description": "Nom de la ville a rechercher"
                },
                {
                  "key": "appid",
                  "value": "{{apiKey}}",
                  "description": "Cle API OpenWeather"
                },
                {
                  "key": "lang",
                  "value": "fr",
                  "description": "Langue des descriptions (francais)"
                }
              ]
            },
            "description": "Endpoint pour recuperer la meteo actuelle d'une ville."
          },
          "response": [
            {
              "name": "Succes - Paris",
